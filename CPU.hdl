
CHIP CPU {
    IN inM[16],
       instruction[16],
       reset;

    OUT outM[16],
        writeM,
        addressM[15],
        pc[15];

    PARTS:

    // Instruction decoding
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=destA);
    And(a=instruction[15], b=instruction[4], out=destD);
    And(a=instruction[15], b=instruction[3], out=destM);

    // A-register input selection
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);

    // A-register
    Or(a=isA, b=destA, out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // D-register
    DRegister(in=aluOut, load=destD, out=dOut);

    // ALU input selection
    Mux16(a=aOut, b=inM, sel=instruction[12], out=yIn);

    // ALU
    ALU(
        x=dOut,
        y=yIn,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Memory write
    And(a=destM, b=true, out=writeM);

    // Jump conditions
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);

    And(a=notZr, b=notNg, out=positive);
    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=positive, out=jgt);

    Or(a=jlt, b=jeq, out=jump1);
    Or(a=jump1, b=jgt, out=jump);

    And(a=instruction[15], b=jump, out=pcLoad);

    // Program Counter
    PC(in=aOut, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}
